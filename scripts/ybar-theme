#!/bin/sh
# ybar-theme — compatibility shim. Theme selection is built into the binary:
#
#   ybar theme list|current|use <name>|reset|install <git-url>
#
# This wrapper only forwards, so existing scripts and docs keep working. It
# also tells the binary where a checkout's examples/ are: the built-in looks
# beside the executable, in the Homebrew keg and in ~/.config/ybar/themes,
# none of which is a source tree.
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
YBAR_THEME_ROOTS="$repo_dir/examples${YBAR_THEME_ROOTS:+:$YBAR_THEME_ROOTS}"
export YBAR_THEME_ROOTS

if command -v ybar >/dev/null 2>&1; then
    exec ybar theme "$@"
fi
for candidate in "$HOME/Applications/YBar.app" "/Applications/YBar.app" \
    "$(brew --prefix 2>/dev/null)/opt/ybar/YBar.app"; do
    [ -x "$candidate/Contents/MacOS/ybar" ] && exec "$candidate/Contents/MacOS/ybar" theme "$@"
done
echo "ybar not found on PATH or in an app bundle (make app, or brew install)" >&2
exit 1
